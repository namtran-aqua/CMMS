@page "/master-data"
@page "/master-data/{SubPath}"
@namespace CMMS.Client.Pages.MasterData
@using CMMS.Client.Pages.MasterData.Catalog
@using CMMS.Client.Pages.MasterData.Category
@using CMMS.Client.Pages.MasterData.Supplier
@using CMMS.Client.Pages.MasterData.Vendor
@using CMMS.Client.Pages.MasterData.Location
@using CMMS.Client.Pages.MasterData.Department
@using CMMS.Client.Pages.MasterData.Factory
@using CMMS.Client.Pages.MasterData.User
<PageTitle>Master Data</PageTitle>

<div class="masterdata-layout" style="background:#f8fafc; min-height: calc(100vh - 64px); overflow-y:auto;">
    <div style="@(selectedTab == "Catalog" ? "" : "display:none;")">
        <PermissionView Code="@CMMS.Shared.Authorization.Permissions.MasterDataCatalogView">
            <CatalogTab />
        </PermissionView>
    </div>
    <div style="@(selectedTab == "Category" ? "" : "display:none;")">
        <PermissionView Code="@CMMS.Shared.Authorization.Permissions.MasterDataCategoryView">
            <CategoryTab />
        </PermissionView>
    </div>
    <div style="@(selectedTab == "Supplier" ? "" : "display:none;")">
        <PermissionView Code="@CMMS.Shared.Authorization.Permissions.MasterDataSupplierView">
            <SupplierTab />
        </PermissionView>
    </div>
    <div style="@(selectedTab == "Vendor" ? "" : "display:none;")">
        <PermissionView Code="@CMMS.Shared.Authorization.Permissions.MasterDataVendorView">
            <VendorTab />
        </PermissionView>
    </div>
    <div style="@(selectedTab == "Location" ? "" : "display:none;")">
        <PermissionView Code="@CMMS.Shared.Authorization.Permissions.MasterDataLocationView">
            <LocationTab />
        </PermissionView>
    </div>
    <div style="@(selectedTab == "Department" ? "" : "display:none;")">
        <PermissionView Code="@CMMS.Shared.Authorization.Permissions.MasterDataDepartmentView">
            <DepartmentTab />
        </PermissionView>
    </div>
    <div style="@(selectedTab == "Factory" ? "" : "display:none;")">
        <PermissionView Code="@CMMS.Shared.Authorization.Permissions.MasterDataFactoryView">
            <FactoryTab />
        </PermissionView>
    </div>
    <div style="@(selectedTab == "User" ? "" : "display:none;")">
        <PermissionView Code="@CMMS.Shared.Authorization.Permissions.MasterDataUserView">
            <UserTab />
        </PermissionView>
    </div>
</div>
