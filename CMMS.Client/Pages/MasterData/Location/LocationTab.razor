@namespace CMMS.Client.Pages.MasterData.Location
@using AntDesign
@using CMMS.Shared.Dtos.Equipment
@using CMMS.Shared.Authorization

<div class="location-catalog-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3>Location Management</h3>
            <p class="text-muted">Create and manage locations in the system.</p>
        </div>
        @if (true) // Replace with role check if needed
        {
            <Button Type="@ButtonType.Primary" OnClick="ShowAddLocationModal" Class="btn-custom">
                <Icon Type="plus" /> Add Location
            </Button>
        }
    </div>

    <!-- Table Card -->
    <div class="card p-4 mb-4" style="border-radius:15px; overflow:hidden; padding: 24px !important;">
        <div class="d-flex justify-content-between align-items-center mb-3"> 
            <h6 class="mb-0" style="font-weight: 700; color: #1e293b;">Locations List</h6>
            <p class="text-muted" style="font-size: 13px; font-weight: 500; margin: 0;">@(Locations?.Count ?? 0) locations total</p>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 150px;">Location Code</th>
                        <th>Location Name</th>
                        <th>Manager</th>
                        <th class="sticky-action" style="width: 150px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Locations != null && Locations.Any())
                    {
                        foreach (var location in Locations)
                        {
                            <tr>
                                <td><strong>@location.LocCode</strong></td>
                                <td>@location.LocName</td>
                                <td>@location.LocManager</td>
                                <td class="sticky-action" style="text-align: center;">
                                    @if (true) // Replace with role check if needed
                                    {
                                        <div style="display:flex; justify-content:center; gap:6px;">
                                            <Tooltip Title="@("Edit")">
                                                <Button Size="ButtonSize.Small" Class="btn-without-title" OnClick="() => ShowEditLocationModal(location)">
                                                    <Icon Type="edit" />
                                                </Button>
                                            </Tooltip>
                                            <Tooltip Title="@("Delete")">
                                                <Popconfirm Title="Are you sure you want to delete this location?"
                                                            OnConfirm="() => DeleteLocation(location.LocID)"
                                                            OkText="Yes"
                                                            CancelText="No">
                                                    <Button Size="ButtonSize.Small" Class="btn-without-title" Danger>
                                                        <Icon Type="delete" />
                                                    </Button>
                                                </Popconfirm>
                                            </Tooltip>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align:center; padding:30px; color:#94a3b8;">Không có dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <Modal Title="@modalTitle"
           Visible="@isLocationModalVisible"
           OnOk="@HandleLocationOk"
           OnCancel="HandleLocationCancel"
           OkText="@("Save")"
           CancelText="@("Cancel")"
           Width="500">
        <Form Model="@editingLocation" Layout="@FormLayout.Vertical">
            <div class="row">
                <div class="col-md-12">
                    <FormItem Label="Location Code">
                        <Input @bind-Value="@editingLocation.LocCode" />
                    </FormItem>
                </div>
                <div class="col-md-12">
                    <FormItem Label="Location Name">
                        <Input @bind-Value="@editingLocation.LocName" />
                    </FormItem>
                </div>
                <div class="col-md-12">
                    <FormItem Label="Manager">
                        <Input @bind-Value="@editingLocation.LocManager" />
                    </FormItem>
                </div>
                <div class="col-md-6">
                    <FormItem Label="Factory ID">
                        <AntDesign.InputNumber @bind-Value="@editingLocation.FACID" />
                    </FormItem>
                </div>
                <div class="col-md-6">
                    <FormItem Label="Department ID">
                        <AntDesign.InputNumber @bind-Value="@editingLocation.DeptID" />
                    </FormItem>
                </div>
            </div>
        </Form>
    </Modal>
</div>
