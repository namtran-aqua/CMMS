@namespace CMMS.Client.Pages.MasterData.Category
@using AntDesign
@using CMMS.Shared.Dtos.SpareParts
@using CMMS.Shared.Authorization

<div class="category-catalog-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3>Category Management</h3>
            <p class="text-muted">Create and manage spare part categories in the system.</p>
        </div>
        @if (true) // Replace with role check if needed
        {
            <Button Type="@ButtonType.Primary" OnClick="ShowAddCategoryModal" Class="btn-custom">
                <Icon Type="plus" /> Add Category
            </Button>
        }
    </div>

    <!-- Table Card -->
    <div class="card p-4 mb-4" style="border-radius:15px; overflow:hidden; padding: 24px !important;">
        <div class="d-flex justify-content-between align-items-center mb-3"> 
            <h6 class="mb-0" style="font-weight: 700; color: #1e293b;">Categories List</h6>
            <p class="text-muted" style="font-size: 13px; font-weight: 500; margin: 0;">@(Categories?.Count ?? 0) categories total</p>
        </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 150px;">Category ID</th>
                    <th>Category Name</th>
                    <th class="sticky-action" style="width: 150px; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Categories != null && Categories.Any())
                {
                    foreach (var category in Categories)
                    {
                        <tr>
                            <td><strong>@category.CategoryID</strong></td>
                            <td>@category.CategoryName</td>
                            <td class="sticky-action" style="text-align: center;">
                                @if (true) // Replace with role check if needed
                                {
                                    <div style="display:flex; justify-content:center; gap:6px;">
                                        <Tooltip Title="@("Edit")">
                                            <Button Size="ButtonSize.Small" Class="btn-without-title" OnClick="() => ShowEditCategoryModal(category)">
                                                <Icon Type="edit" />
                                            </Button>
                                        </Tooltip>
                                        <Tooltip Title="@("Delete")">
                                            <Popconfirm Title="Are you sure you want to delete this category?"
                                                        OnConfirm="() => DeleteCategory(category.CategoryID)"
                                                        OkText="Yes"
                                                        CancelText="No">
                                                <Button Size="ButtonSize.Small" Class="btn-without-title" Danger>
                                                    <Icon Type="delete" />
                                                </Button>
                                            </Popconfirm>
                                        </Tooltip>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" style="text-align:center; padding:30px; color:#94a3b8;">Không có dữ liệu.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>

    <Modal Title="@modalTitle"
           Visible="@isCategoryModalVisible"
           OnOk="@HandleCategoryOk"
           OnCancel="HandleCategoryCancel"
           OkText="@("Save")"
           CancelText="@("Cancel")">
        <Form Model="@editingCategory" Layout="@FormLayout.Vertical">
            <FormItem Label="Category Name">
                <Input @bind-Value="@editingCategory.CategoryName" />
            </FormItem>
        </Form>
    </Modal>
</div>
