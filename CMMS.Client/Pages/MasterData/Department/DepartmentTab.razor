@namespace CMMS.Client.Pages.MasterData.Department
@using AntDesign
@using CMMS.Shared.Dtos.Equipment
@using CMMS.Shared.Authorization

<div class="department-catalog-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3>Department Management</h3>
            <p class="text-muted">Create and manage departments in the system.</p>
        </div>
        @if (true) // Replace with role check if needed
        {
            <Button Type="@ButtonType.Primary" OnClick="ShowAddDepartmentModal" Class="btn-custom">
                <Icon Type="plus" /> Add Department
            </Button>
        }
    </div>

    <!-- Table Card -->
    <div class="card p-4 mb-4" style="border-radius:15px; overflow:hidden; padding: 24px !important;">
        <div class="d-flex justify-content-between align-items-center mb-3"> 
            <h6 class="mb-0" style="font-weight: 700; color: #1e293b;">Departments List</h6>
            <p class="text-muted" style="font-size: 13px; font-weight: 500; margin: 0;">@(Departments?.Count ?? 0) departments total</p>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 150px;">Dept Code</th>
                        <th>Department Name</th>
                        <th>Factory</th>
                        <th>HOD/WD</th>
                        <th class="sticky-action" style="width: 150px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Departments != null && Departments.Any())
                    {
                        foreach (var dept in Departments)
                        {
                            <tr>
                                <td><strong>@dept.DeptCode</strong></td>
                                <td>@dept.DeptName</td>
                                <td>@dept.FACName</td>
                                <td>@dept.HODWD</td>
                                <td class="sticky-action" style="text-align: center;">
                                    @if (true) // Replace with role check if needed
                                    {
                                        <div style="display:flex; justify-content:center; gap:6px;">
                                            <Tooltip Title="@("Edit")">
                                                <Button Size="ButtonSize.Small" Class="btn-without-title" OnClick="() => ShowEditDepartmentModal(dept)">
                                                    <Icon Type="edit" />
                                                </Button>
                                            </Tooltip>
                                            <Tooltip Title="@("Delete")">
                                                <Popconfirm Title="Are you sure you want to delete this department?"
                                                            OnConfirm="() => DeleteDepartment(dept.DeptID)"
                                                            OkText="Yes"
                                                            CancelText="No">
                                                    <Button Size="ButtonSize.Small" Class="btn-without-title" Danger>
                                                        <Icon Type="delete" />
                                                    </Button>
                                                </Popconfirm>
                                            </Tooltip>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; padding:30px; color:#94a3b8;">Không có dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <Modal Title="@modalTitle"
           Visible="@isDepartmentModalVisible"
           OnOk="@HandleDepartmentOk"
           OnCancel="HandleDepartmentCancel"
           OkText="@("Save")"
           CancelText="@("Cancel")"
           Width="500">
        <Form Model="@editingDepartment" Layout="@FormLayout.Vertical">
            <div class="row">
                <div class="col-md-12">
                    <FormItem Label="Department Code">
                        <Input @bind-Value="@editingDepartment.DeptCode" />
                    </FormItem>
                </div>
                <div class="col-md-12">
                    <FormItem Label="Department Name">
                        <Input @bind-Value="@editingDepartment.DeptName" />
                    </FormItem>
                </div>
                <div class="col-md-12">
                    <FormItem Label="HOD/WD">
                        <Input @bind-Value="@editingDepartment.HODWD" />
                    </FormItem>
                </div>
                <div class="col-md-12">
                    <FormItem Label="Factory ID">
                        <AntDesign.InputNumber @bind-Value="@editingDepartment.FACID" />
                    </FormItem>
                </div>
            </div>
        </Form>
    </Modal>
</div>
