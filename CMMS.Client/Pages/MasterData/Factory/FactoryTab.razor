@namespace CMMS.Client.Pages.MasterData.Factory
@using AntDesign
@using CMMS.Shared.Dtos.Equipment
@using CMMS.Shared.Authorization

<div class="factory-catalog-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3>Factory Management</h3>
            <p class="text-muted">Create and manage factories in the system.</p>
        </div>
        @if (true) // Replace with role check if needed
        {
            <Button Type="@ButtonType.Primary" OnClick="ShowAddFactoryModal" Class="btn-custom">
                <Icon Type="plus" /> Add Factory
            </Button>
        }
    </div>

    <!-- Table Card -->
    <div class="card p-4 mb-4" style="border-radius:15px; overflow:hidden; padding: 24px !important;">
        <div class="d-flex justify-content-between align-items-center mb-3"> 
            <h6 class="mb-0" style="font-weight: 700; color: #1e293b;">Factories List</h6>
            <p class="text-muted" style="font-size: 13px; font-weight: 500; margin: 0;">@(Factories?.Count ?? 0) factories total</p>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 150px;">Factory Code</th>
                        <th>Factory Name</th>
                        <th>Full Name</th>
                        <th class="sticky-action" style="width: 150px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Factories != null && Factories.Any())
                    {
                        foreach (var factory in Factories)
                        {
                            <tr>
                                <td><strong>@factory.FACCode</strong></td>
                                <td>@factory.FACName</td>
                                <td>@factory.FACFullName</td>
                                <td class="sticky-action" style="text-align: center;">
                                    @if (true) // Replace with role check if needed
                                    {
                                        <div style="display:flex; justify-content:center; gap:6px;">
                                            <Tooltip Title="@("Edit")">
                                                <Button Size="ButtonSize.Small" Class="btn-without-title" OnClick="() => ShowEditFactoryModal(factory)">
                                                    <Icon Type="edit" />
                                                </Button>
                                            </Tooltip>
                                            <Tooltip Title="@("Delete")">
                                                <Popconfirm Title="Are you sure you want to delete this factory?"
                                                            OnConfirm="() => DeleteFactory(factory.FACID)"
                                                            OkText="Yes"
                                                            CancelText="No">
                                                    <Button Size="ButtonSize.Small" Class="btn-without-title" Danger>
                                                        <Icon Type="delete" />
                                                    </Button>
                                                </Popconfirm>
                                            </Tooltip>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align:center; padding:30px; color:#94a3b8;">Không có dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <Modal Title="@modalTitle"
           Visible="@isFactoryModalVisible"
           OnOk="@HandleFactoryOk"
           OnCancel="HandleFactoryCancel"
           OkText="@("Save")"
           CancelText="@("Cancel")"
           Width="500">
        <Form Model="@editingFactory" Layout="@FormLayout.Vertical">
            <div class="row">
                <div class="col-md-12">
                    <FormItem Label="Factory Code">
                        <Input @bind-Value="@editingFactory.FACCode" />
                    </FormItem>
                </div>
                <div class="col-md-12">
                    <FormItem Label="Factory Name">
                        <Input @bind-Value="@editingFactory.FACName" />
                    </FormItem>
                </div>
                <div class="col-md-12">
                    <FormItem Label="Full Name">
                        <Input @bind-Value="@editingFactory.FACFullName" />
                    </FormItem>
                </div>
            </div>
        </Form>
    </Modal>
</div>
