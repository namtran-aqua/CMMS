@page "/qr-code-management"
@using CMMS.Shared.Dtos.Barcode
@using AntDesign
@inject HttpClient Http
@inject IMessageService MessageService
@inject IJSRuntime JSRuntime

<PageTitle>QR Code Management</PageTitle>

<Card Title="QR Code Management" Style="margin-bottom: 24px;">
    <!-- Actions Panel -->
    <div style="margin-bottom: 16px; text-align: right;">
        <PermissionView Code="QRCODE.GENERATE">
            <Button Type="@ButtonType.Primary" OnClick="GenerateBarcodes" Loading="IsGenerating" Disabled="!HasSelectedNotGenerated" Style="height:38px; border-radius: 8px; padding: 0 20px;">Generate Barcode ID</Button>
        </PermissionView>
        <Button Type="@ButtonType.Primary" OnClick="ExportPdf" Loading="IsExporting" Disabled="!HasSelectedGenerated" Style="@(HasSelectedGenerated ? "margin-left: 8px; height:38px; border-radius: 8px; padding: 0 20px; background-color: #10b981; border-color: #10b981; color: white; font-weight: 500;" : "margin-left: 8px; height:38px; border-radius: 8px; padding: 0 20px;")">
            Export PDF
        </Button>
    </div>

    <!-- Search Panel -->
    <div style="display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; align-items: flex-end;">
        <div style="flex: 1; min-width: 250px;">
            <label style="font-size:12px; font-weight:600; color:#64748b; margin-bottom: 4px; display: block;">Keyword Search</label>
            <input type="text" class="form-control" placeholder="Search code, name, serial..." @bind="SearchKeyword" @onkeyup="HandleKeyUp" style="height:38px; border-radius:8px;" />
        </div>
        <div style="flex: 1; min-width: 200px;">
            <label style="font-size:12px; font-weight:600; color:#64748b; margin-bottom: 4px; display: block;">Type</label>
            <select class="form-select" @bind="SelectedType" style="height:38px; border-radius:8px;">
                <option value="All">All Types</option>
                <option value="Equipment">Equipment</option>
                <option value="SparePart">Spare Part</option>
            </select>
        </div>
        <div style="flex: 1; min-width: 200px;">
            <label style="font-size:12px; font-weight:600; color:#64748b; margin-bottom: 4px; display: block;">Status</label>
            <select class="form-select" @bind="SelectedStatus" style="height:38px; border-radius:8px;">
                <option value="All">All Status</option>
                <option value="NotGenerated">Not Generated</option>
                <option value="Generated">Generated</option>
            </select>
        </div>
        <div style="display: flex; gap: 8px; height: 38px;">
            <Button Type="@ButtonType.Primary" OnClick="LoadData" Style="height:38px; border-radius: 8px; padding: 0 20px;">Query</Button>
            <Button Type="@ButtonType.Default" OnClick="ResetFilter" Style="height:38px; border-radius: 8px; padding: 0 20px;">Reset</Button>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card p-4 mb-4" style="border-radius:15px; overflow:hidden; padding: 24px !important;">
        <div class="d-flex justify-content-between align-items-center mb-3"> 
            <h6 class="mb-0" style="font-weight: 700; color: #1e293b;">Data List</h6>
            <p class="text-muted" style="font-size: 13px; font-weight: 500; margin-bottom: 0;">@Items.Count items total</p>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 50px; text-align: center;">
                            <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleAll" style="width: 18px; height: 18px; cursor: pointer;" />
                        </th>
                        <th>Barcode ID</th>
                        <th>Type</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th style="text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; padding:30px;">
                                <Spin />
                            </td>
                        </tr>
                    }
                    else if (Items != null && Items.Any())
                    {
                        foreach (var context in Items.Skip((pageIndex - 1) * pageSize).Take(pageSize))
                        {
                            <tr @onclick="() => ToggleRowSelection(context)" style="cursor: pointer;" class="table-row-hover">
                                <td style="text-align: center;" @onclick:stopPropagation="true">
                                    <input type="checkbox" checked="@SelectedItems.Contains(context)" @onchange="(e) => ToggleRow(e, context)" style="width: 18px; height: 18px; cursor: pointer;" />
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(context.BarcodeId))
                                    {
                                        <Tag Color="@("orange")">Not Generated</Tag>
                                    }
                                    else
                                    {
                                        <Tag Color="@("green")">@context.BarcodeId</Tag>
                                    }
                                </td>
                                <td>@context.EntityType</td>
                                <td>@context.Code</td>
                                <td>@context.Name</td>
                                <td style="text-align: center;" @onclick:stopPropagation="true">
                                    @if (!string.IsNullOrEmpty(context.BarcodeId))
                                    {
                                        <Button Type="@ButtonType.Default" OnClick="() => ShowQrModal(context)" Style="border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; height: 32px; padding: 0 16px;">
                                            Show QR Code
                                        </Button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; padding:30px; color:#94a3b8;">No data found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Items != null && Items.Any())
        {
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span style="font-size:12px; color:#595959;">
                    Showing @(((pageIndex - 1) * pageSize) + 1) to @(Math.Min(pageIndex * pageSize, Items.Count)) of @Items.Count items
                </span>
                <Pagination Total="Items.Count"
                            @bind-PageSize="pageSize"
                            @bind-Current="pageIndex"
                            PageSizeOptions="new[] { 10, 20, 50, 100 }"
                            ShowSizeChanger="true"
                            OnChange="OnPageChange"
                            Size="PaginationSize.Small" />
            </div>
        }
    </div>
</Card>

<Modal Title="@("QR Code Details")" Visible="@isQrModalVisible" OnCancel="CloseQrModal" Footer="null" Centered="true">
    @if (currentItemForQr != null)
    {
        <div style="text-align: center; padding: 20px;">
            <div style="margin-bottom: 16px;">
                <h5 style="margin-bottom: 4px; font-weight: 600;">@currentItemForQr.Name</h5>
                <p style="color: #64748b; margin-bottom: 0;">Code: @currentItemForQr.Code</p>
                @if (!string.IsNullOrEmpty(currentItemForQr.Serial))
                {
                    <p style="color: #64748b; margin-bottom: 0;">Serial: @currentItemForQr.Serial</p>
                }
            </div>
            
            <div style="background-color: #f8fafc; padding: 20px; border-radius: 12px; display: inline-block; margin-bottom: 24px; border: 1px solid #e2e8f0;">
                <img src="@($"{Http.BaseAddress?.ToString().TrimEnd('/')}/api/qr/image/{currentItemForQr.BarcodeId}")" alt="QR Code" style="width: 200px; height: 200px; object-fit: contain;" />
                <p style="margin-top: 12px; font-weight: 600; color: #334155; font-family: monospace; letter-spacing: 1px;">@currentItemForQr.BarcodeId</p>
            </div>
            
            <div style="display: flex; justify-content: center; gap: 12px;">
                <Button Type="@ButtonType.Default" OnClick="CloseQrModal" Style="border-radius: 6px; padding: 0 20px;">Close</Button>
                <Button Type="@ButtonType.Primary" OnClick="PrintSingleBarcode" Style="border-radius: 6px; padding: 0 20px;">
                    Print Barcode
                </Button>
            </div>
        </div>
    }
</Modal>



