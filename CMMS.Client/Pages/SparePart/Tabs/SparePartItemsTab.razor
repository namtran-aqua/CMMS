@namespace CMMS.Client.Pages.SpareParts.Tabs
@using AntDesign
@using CMMS.Shared.Dtos.SpareParts
@using CMMS.Client.Common

<!-- Header -->
<div class="d-flex justify-content-between align-items-center">
    <div>
        <h3>@(IsCoded == false ? "Non-Coded Parts Tracking" : (IsCoded == true ? "Coded Parts Tracking" : "Spare Part Items Tracking"))</h3>
        <p class="text-muted">Audit spare part items and their active storage status</p>
    </div>
</div>

<!-- Filter Panel -->
<div class="card p-3 mb-3 search-card" style="border-radius:15px">
    <div style="display:flex; justify-content:space-between; align-items:center; cursor:pointer;" @onclick="() => isSearchPanelCollapsed = !isSearchPanelCollapsed">
        <div style="font-weight:700; color:#1e293b; font-size:14px;">
            <Icon Type="search" Style="margin-right:8px;" /> Advanced Search Filters
        </div>
        <div>
            <Icon Type="@(isSearchPanelCollapsed ? "down" : "up")" />
        </div>
    </div>

    @if (!isSearchPanelCollapsed)
    {
        <div class="row mt-3" style="gap:12px 0;">
            @if (IsCoded != false)
            {
                <div class="col-md-3">
                    <label style="font-size:12px; font-weight:600; color:#64748b;">Serial Code</label>
                    <Input placeholder="Serial code..." @bind-Value="serialSearch" Class="form-control" />
                </div>
            }
            <div class="col-md-3">
                <label style="font-size:12px; font-weight:600; color:#64748b;">Part Code</label>
                <Input placeholder="Part code..." @bind-Value="partCodeSearch" Class="form-control" />
            </div>
            <div class="col-md-3">
                <label style="font-size:12px; font-weight:600; color:#64748b;">Part Name</label>
                <Input placeholder="Part name..." @bind-Value="partNameSearch" Class="form-control" />
            </div>
            <div class="col-md-3">
                <label style="font-size:12px; font-weight:600; color:#64748b;">Status</label>
                <select class="form-select" @bind="statusFilter" style="height:38px; border-radius:8px;">
                    <option value="">All Statuses</option>
                    <option value="Available">Available</option>
                    <option value="Reserved">Reserved</option>
                    <option value="Installed">Installed</option>
                    <option value="Scrapped">Scrapped</option>
                    <option value="Returned">Returned</option>
                    <option value="Lost">Lost</option>
                </select>
            </div>
            <div class="col-md-12 d-flex justify-content-end" style="gap:8px; margin-top:8px;">
                <Button Type="@ButtonType.Primary" OnClick="ApplyFilters" Class="btn-custom">Query</Button>
                <Button Type="@ButtonType.Default" OnClick="ResetFilters" Class="btn-custom">Reset</Button>
            </div>
        </div>
    }
</div>

<!-- Grids Card -->
<div class="card p-4 mb-4" style="border-radius:15px; overflow:hidden; padding: 24px !important;">
    <div class="d-flex justify-content-between align-items-center mb-3"> 
        <h6 class="mb-0" style="font-weight: 700; color: #1e293b;">Items List</h6>
        <p class="text-muted" style="font-size: 13px; font-weight: 500; margin-bottom: 0;">@FilteredItems.Count items tracked</p>
    </div>
    <div class="table-responsive">
        <table class="table">
        <thead>
            <tr>
                @if (IsCoded != false)
                {
                    <th>Serial Code</th>
                }
                <th>Part Code</th>
                <th>Part Name</th>
                <th>Import Date</th>
                <th>Import Qty</th>
                <th>Remaining Qty</th>
                <th>Age (Days)</th>
                <th>Status</th>
                @* <th class="sticky-action" style="width: 120px; text-align: center;">Action</th> *@
            </tr>
        </thead>
        <tbody>
            @if (FilteredItems != null && FilteredItems.Any())
            {
                foreach (var item in FilteredItems.Skip((currentPage - 1) * pageSize).Take(pageSize))
                {
                    <tr>
                        @if (IsCoded != false)
                        {
                            <td><strong style="color:#0f172a;">@item.SerialCode</strong></td>
                        }
                        <td>@item.PartCode</td>
                        <td>@item.PartName</td>
                        <td>@item.ImportDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.Quantity</td>
                        <td><strong>@item.RemainingQuantity</strong></td>
                        <td>
                            @if (item.DaysInStock <= 30)
                            {
                                <span class="badge" style="background:#dcfce3; color:#166534;">@item.DaysInStock</span>
                            }
                            else if (item.DaysInStock <= 90)
                            {
                                <span class="badge" style="background:#ffedd5; color:#9a3412;">@item.DaysInStock</span>
                            }
                            else
                            {
                                <span class="badge" style="background:#fee2e2; color:#991b1b;">@item.DaysInStock</span>
                            }
                        </td>
                        <td>
                            <span class="status-badge badge-@item.Status.ToLower()">@item.Status</span>
                        </td>
                        @* <td class="sticky-action" style="text-align: center;">
                            <Button Size="ButtonSize.Small" Class="btn-custom" OnClick="() => ShowItemDetail(item.ItemID)"><Icon Type="eye" /> Details</Button>
                        </td> *@
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" style="text-align:center; padding:30px; color:#94a3b8;">Không có mặt hàng nào phù hợp.</td>
                </tr>
            }
        </tbody>
        </table>
    </div>
    @if (FilteredItems != null && FilteredItems.Any())
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span style="font-size:12px; color:#595959;">
                Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, FilteredItems.Count)) of @FilteredItems.Count items
            </span>
            <Pagination Total="FilteredItems.Count"
                        @bind-PageSize="pageSize"
                        @bind-Current="currentPage"
                        PageSizeOptions="new[] { 10, 20, 50, 100 }"
                        ShowSizeChanger="true"
                        OnChange="OnPageChange"
                        Size="PaginationSize.Small" />
        </div>
    }
</div>
