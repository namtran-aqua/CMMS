@inherits LayoutComponentBase
@using CMMS.Client.Shared
@using CMMS.Client.Services
@using AntDesign
@using CMMS.Shared.Dtos.Equipment
@using CMMS.Shared.Dtos.User
@using CMMS.Shared.Authorization
@using System.Net.Http.Json
<div class="app-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div style="font-size: 20px; font-weight: 600;" class="sidebar-header">
            <div class="logo-box">
                <i class="fa-solid fa-sliders"></i>
            </div>
            <div class="sidebar-title">
                <div class="title">CMMS</div>
                @* <div class="subtitle">CMMS v1.0</div> *@
            </div>
        </div>

        <div class="menu-container">
            <Menu Mode="MenuMode.Inline"
                  Theme="MenuTheme.Light"
                  Class="custom-menu">

            <SubMenu Key="dashboards">
                <TitleTemplate>
                    <div class="menu-link">
                        <i class="fa-solid fa-chart-line menu-icon"></i>
                        <span>Dashboards</span>
                    </div>
                </TitleTemplate>
                <ChildContent>
                    <MenuItem Key="db-equipment">
                        <NavLink href="@GetLink("/dash-board/equipment")" class="menu-link" Match="NavLinkMatch.All">
                            <i class="fa-solid fa-table-cells menu-icon"></i>
                            <span>Equipment</span>
                        </NavLink>
                    </MenuItem>
                    <MenuItem Key="db-spare-part">
                        <NavLink href="@GetLink("/spare-parts/dashboard")" class="menu-link">
                            <i class="fa-solid fa-chart-pie menu-icon"></i>
                            <span>Spare Part</span>
                        </NavLink>
                    </MenuItem>
                </ChildContent>
            </SubMenu>
            @if (CurrentUser != null && !string.IsNullOrEmpty(CurrentUser.FullName))
            {
                <SubMenu Key="master-data">
                    <TitleTemplate>
                        <div class="menu-link">
                            <i class="fa-solid fa-database menu-icon"></i>
                            <span>Master Data</span>
                        </div>
                    </TitleTemplate>
                    <ChildContent>
                        <PermissionView Code="@Permissions.MasterDataCatalogView">
                            <MenuItem Key="md-catalog">
                                <NavLink href="@GetLink("/master-data/spare-part-catalog")" class="menu-link">
                                    <i class="fa-solid fa-folder-open menu-icon"></i>
                                    <span>Catalog Spare Parts</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.MasterDataCategoryView">
                            <MenuItem Key="md-category">
                                <NavLink href="@GetLink("/master-data/category")" class="menu-link">
                                    <i class="fa-solid fa-tags menu-icon"></i>
                                    <span>Category</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.MasterDataSupplierView">
                            <MenuItem Key="md-supplier">
                                <NavLink href="@GetLink("/master-data/supplier")" class="menu-link">
                                    <i class="fa-solid fa-truck-field menu-icon"></i>
                                    <span>Supplier</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.MasterDataVendorView">
                            <MenuItem Key="md-vendor">
                                <NavLink href="@GetLink("/master-data/vendor")" class="menu-link">
                                    <i class="fa-solid fa-store menu-icon"></i>
                                    <span>Vendor</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.MasterDataLocationView">
                            <MenuItem Key="md-location">
                                <NavLink href="@GetLink("/master-data/location")" class="menu-link">
                                    <i class="fa-solid fa-location-dot menu-icon"></i>
                                    <span>Location</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.MasterDataDepartmentView">
                            <MenuItem Key="md-department">
                                <NavLink href="@GetLink("/master-data/department")" class="menu-link">
                                    <i class="fa-solid fa-building-user menu-icon"></i>
                                    <span>Department</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.MasterDataFactoryView">
                            <MenuItem Key="md-factory">
                                <NavLink href="@GetLink("/master-data/factory")" class="menu-link">
                                    <i class="fa-solid fa-industry menu-icon"></i>
                                    <span>Factory</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.MasterDataUserView">
                            <MenuItem Key="md-user">
                                <NavLink href="@GetLink("/master-data/user")" class="menu-link">
                                    <i class="fa-solid fa-users menu-icon"></i>
                                    <span>Users</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.MasterDataRolePermissionView">
                            <MenuItem Key="md-role-permission">
                                <NavLink href="@GetLink("/master-data/role-permission")" class="menu-link">
                                    <i class="fa-solid fa-user-shield menu-icon"></i>
                                    <span>Roles & Permissions</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                    </ChildContent>
                </SubMenu>
                <SubMenu Key="spare-parts">
                    <TitleTemplate>
                        <div class="menu-link">
                            <i class="fa-solid fa-box menu-icon"></i>
                            <span>Spare Parts</span>
                        </div>
                    </TitleTemplate>
                    <ChildContent>
                        <PermissionView Code="@Permissions.SparePartInventoryView">
                            <MenuItem Key="sp-inventory">
                                <NavLink href="@GetLink("/spare-parts/inventory")" class="menu-link">
                                    <i class="fa-solid fa-boxes-stacked menu-icon"></i>
                                    <span>Inventory Stock</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.SparePartCodedView">
                            <MenuItem Key="sp-coded">
                                <NavLink href="@GetLink("/spare-parts/coded-parts")" class="menu-link">
                                    <i class="fa-solid fa-barcode menu-icon"></i>
                                    <span>Coded Parts</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.SparePartNonCodedView">
                            <MenuItem Key="sp-non-coded">
                                <NavLink href="@GetLink("/spare-parts/non-coded")" class="menu-link">
                                    <i class="fa-solid fa-layer-group menu-icon"></i>
                                    <span>Non-Coded Parts</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.SparePartInboundView">
                            <MenuItem Key="sp-imports">
                                <NavLink href="@GetLink("/spare-parts/imports")" class="menu-link">
                                    <i class="fa-solid fa-file-import menu-icon"></i>
                                    <span>Inbound</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.SparePartOutboundView">
                            <MenuItem Key="sp-exports">
                                <NavLink href="@GetLink("/spare-parts/exports")" class="menu-link">
                                    <i class="fa-solid fa-file-export menu-icon"></i>
                                    <span>Outbound</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.SparePartAdjustmentView">
                            <MenuItem Key="sp-adjustments">
                                <NavLink href="@GetLink("/spare-parts/adjustments")" class="menu-link">
                                    <i class="fa-solid fa-scale-balanced menu-icon"></i>
                                    <span>Stock Adjustments</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                        <PermissionView Code="@Permissions.SparePartTransactionsView">
                            <MenuItem Key="sp-history">
                                <NavLink href="@GetLink("/spare-parts/history")" class="menu-link">
                                    <i class="fa-solid fa-clock-rotate-left menu-icon"></i>
                                    <span>Transactions Log</span>
                                </NavLink>
                            </MenuItem>
                        </PermissionView>
                    </ChildContent>
                </SubMenu>
                <PermissionView Code="@Permissions.EquipmentView">
                    <MenuItem>
                        <NavLink href="@GetLink("/equipment")" class="menu-link">
                            <i class="fa-solid fa-sliders menu-icon"></i>
                            <span>Equipment</span>
                        </NavLink>
                    </MenuItem>
                </PermissionView>

                <PermissionView Code="@Permissions.MaintenanceView">
                    <MenuItem>
                        <NavLink href="@GetLink("/maintenance")" class="menu-link">
                            <i class="fa-solid fa-wrench menu-icon"></i>
                            <span>Maintenance</span>
                        </NavLink>
                    </MenuItem>
                </PermissionView>
            }
            </Menu>
        </div>
    </aside>

    <!-- MAIN - LOGIN INFO-->
    <section class="main">
        <header class="topbar">
            <!-- Filters Group -->
            <div class="filters-container" style="display: flex; gap: 16px;">
                <!-- Factory Selector -->
                <div class="factory-filter">

                    <div class="factory-select-wrapper">

                        <i class="fa-solid fa-warehouse factory-icon"></i>

                        <select class="factory-select"
                                @onchange="OnFactoryChanged"
                                value="@(FactoryState.SelectedFacId?.ToString() ?? "")">

                            <option value="">All Factories</option>

                            @foreach (var fac in FactoryState.Factories)
                            {
                                <option value="@fac.FacId">
                                    @fac.FacCode - @fac.FacName
                                </option>
                            }

                        </select>

                        <i class="fa-solid fa-chevron-down factory-arrow"></i>

                    </div>

                </div>

                <!-- Department Selector -->
                <div class="factory-filter">

                    <div class="factory-select-wrapper">

                        <i class="fa-solid fa-building factory-icon"></i>

                        <select class="factory-select"
                                @onchange="OnDepartmentChanged"
                                value="@(FactoryState.SelectedDeptId?.ToString() ?? "")">

                            <option value="">All Departments</option>

                            @foreach (var dept in FactoryState.FilteredDepartments)
                            {
                                <option value="@dept.DeptID">
                                    @(dept.DeptCode ?? dept.DeptName) - @dept.DeptName
                                </option>
                            }

                        </select>

                        <i class="fa-solid fa-chevron-down factory-arrow"></i>

                    </div>

                </div>
            </div>

            @if (CurrentUser != null && !string.IsNullOrEmpty(CurrentUser.FullName))
            {
                <div class="user-display">
                    @if (!string.IsNullOrEmpty(CurrentUser.Avatar))
                    {
                        <img class="user-avatar" src="@CurrentUser.Avatar" alt="Avatar" />
                    }
                    else
                    {
                        <div class="user-avatar-placeholder">
                            @CurrentUser.FullName.Substring(0, 1).ToUpper()
                        </div>
                    }
                    <div class="user-details">
                        <div class="user-fullname">@CurrentUser.FullName</div>
                        <div class="user-workday">ID: @CurrentUser.WorkDayId</div>
                    </div>
                    <button class="btn btn-logout" @onclick="Logout">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                </div>
            }
            else
            {
                <button class="btn btn-login" @onclick="GoToLogin">
                    <i class="fa-solid fa-right-to-bracket"></i> Login
                </button>
            }
        </header>
        <main class="content">
            @Body
        </main>
    </section>

</div>
